{
  "name": "subscription-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n server,frontend -c blue,green \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "seed": "npm run seed -w server",
    "seed:large": "npm run seed:large -w server",
    "test": "npm test -w server",
    "build": "npm run build -w frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:fresh": "npm run seed:fresh -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
